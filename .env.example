# Copy to .env and export (or pass to your process manager). Everything is optional except one auth mode.
PORT=8107
BASE_URL=http://localhost:8107

# Public mode: Google sign-in. Create a "Web application" OAuth client in Google Cloud Console and add
# BASE_URL/auth/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chat ("Ask the Reader"): an Anthropic API key. Without one, public mode turns chat off.
ANTHROPIC_API_KEY=
PL_MODEL=claude-haiku-5-5
USER_DAILY_USD=0.15      # estimated spend per user per day
MONTHLY_USD=25           # estimated spend for everyone per month; chat pauses when reached

ADMINS=you@example.com   # may open /api/admin/usage
DATA_DIR=./data-local    # SQLite database and session secret

# Local trial without Google: DEV_USER=you@example.com (localhost only)
